#!/usr/bin/env bash
set -euo pipefail

: "${VM:?Set VM, e.g. VM=ubuntu@51.20.14.115 ./scripts/run_load_tests.sh}"
REPO_DIR=${REPO_DIR:-Digit-Classifier-MLOps-Pipeline}
PORT=${PORT:-8000}
USERS=${1:-100}
DURATION=${2:-2m}
HOST="http://${VM#*@}:${PORT}"

cd "$(dirname "$0")/.."
mkdir -p locust/results

for N in 1 2 4; do
  echo "=== $N container(s), $USERS users, $DURATION ==="
  ssh "$VM" "cd '$REPO_DIR' && docker compose up -d --scale api=$N && docker compose restart nginx"
  until curl -sf "$HOST/health" > /dev/null; do sleep 3; done
  sleep 20   # lets every replica finish loading the model
  locust -f locust/locustfile.py --host "$HOST" --headless \
         -u "$USERS" -r 10 -t "$DURATION" --csv "locust/results/c${N}" --only-summary
done

python scripts/summarize_locust.py